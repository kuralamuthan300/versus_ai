# ==========================================
# Versus AI - Project .gitignore
# ==========================================

# --- System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Environment Variables & Secrets ---
# Keep local configurations and secrets private
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
secrets.toml

# --- Virtual Environments & Dependency Managers ---
# Default uv & python virtual environments
.venv/
venv/
ENV/
env/
# In case the user created venvs with names like 'activate' or 'list'
activate/
list/

# --- Python Build & Packaging ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
build/
develop-eggs/
dist/
downloads/
include/
bin/

# --- Testing, Linting & Caches ---
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.ipynb_checkpoints/
.tox/
.nox/
.coverage
.coverage.*
.coveragerc
htmlcov/
nosetests.xml
pip-log.txt
pip-delete-this-directory.txt

# --- IDEs & Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.project
.pydevproject
.settings/

# --- Project-Specific ---
sandbox/
